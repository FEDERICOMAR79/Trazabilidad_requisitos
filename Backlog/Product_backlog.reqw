            {
              "id": "3",
              "guid": "5ef2d367-8665-45a4-9ab4-7e32a88d5fae",
              "deleted": true,
              "heading": "Scope",
              "instructions": "<p>Briefly describe the scope of the product.</p>",
              "type": "SEC",
